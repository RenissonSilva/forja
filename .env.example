# Copie este arquivo para .env e ajuste se necessário.
# Todas as variáveis usadas no app cliente precisam do prefixo EXPO_PUBLIC_
# (são embutidas no bundle — nunca coloque segredos aqui).

# development | production
EXPO_PUBLIC_APP_ENV=development

# Settings -> API no painel do seu projeto Supabase
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxx
