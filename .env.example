# Copie este arquivo para .env e ajuste se necessário.
# Todas as variáveis usadas no app cliente precisam do prefixo EXPO_PUBLIC_
# (são embutidas no bundle — nunca coloque segredos aqui).

# development | production
EXPO_PUBLIC_APP_ENV=development

# Nome do arquivo do banco SQLite local (fica no sandbox do app no dispositivo)
EXPO_PUBLIC_DB_NAME=forja.db
